<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EDEAF5">

    <!-- 顶栏：连接状态 + 启动按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#781E2028"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="○ 未连接"
            android:textColor="#FF8E8E93"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/connectionInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="点按启动"
            android:textColor="#8E8E93"
            android:textSize="13sp" />

        <!-- 启动按钮（连接后隐藏） -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:background="#6d7f9e"
            android:gravity="center"
            android:text="启动"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 消息列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:layout_margin="8dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messageList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />
    </FrameLayout>

    <!-- 底部输入区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:elevation="4dp"
        android:padding="10dp"
        android:layout_margin="8dp">

        <!-- 置顶选项 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <CheckBox
                android:id="@+id/pinCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 置顶"
                android:textSize="13sp"
                android:textColor="#5A5A7A" />

            <Button
                android:id="@+id/pinDuration1h"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_glass_dark"
                android:text="1h"
                android:textSize="11sp"
                android:textColor="#CCC"
                android:textAllCaps="false"
                android:enabled="false"
                android:alpha="0.4"
                android:padding="0dp" />

            <Button
                android:id="@+id/pinDuration6h"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_button_gradient"
                android:text="6h"
                android:textSize="11sp"
                android:textColor="#FFF"
                android:textAllCaps="false"
                android:enabled="false"
                android:alpha="0.4"
                android:padding="0dp" />

            <Button
                android:id="@+id/pinDuration24h"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_glass_dark"
                android:text="24h"
                android:textSize="11sp"
                android:textColor="#CCC"
                android:textAllCaps="false"
                android:enabled="false"
                android:alpha="0.4"
                android:padding="0dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/reminderBody"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_input_glass"
            android:gravity="center_vertical|start"
            android:hint="输入提醒内容..."
            android:maxLength="200"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <!-- 底栏：左=照片+悬浮 右=发送 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp">

            <!-- 左侧工具按钮 -->
            <LinearLayout
                android:id="@+id/leftTools"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSendPhoto"
                    android:layout_width="52dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_dark"
                    android:gravity="center"
                    android:text="照片"
                    android:textColor="#CCC"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBubble"
                    android:layout_width="60dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_dark"
                    android:gravity="center"
                    android:text="悬浮窗"
                    android:textColor="#CCC"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 右侧发送按钮 -->
            <Button
                android:id="@+id/btnRemindPc"
                android:layout_width="100dp"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_button_gradient"
                android:enabled="false"
                android:gravity="center"
                android:text="发送 →"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
