<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 拖拽头 -->
        <FrameLayout
            android:id="@+id/bubbleHeader"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_dark"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="✎ 快速发送"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 展开/收起历史按钮 -->
                <TextView
                    android:id="@+id/btnBubbleHistory"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="4dp"
                    android:background="#555"
                    android:gravity="center"
                    android:text="☰"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnBubbleClose"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:background="#CC4444"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:paddingHorizontal="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- 消息历史列表（默认收起，点击展开） -->
        <LinearLayout
            android:id="@+id/bubbleHistoryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="── 最近消息 ──"
                android:textSize="10sp"
                android:textColor="#999"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bubbleHistoryList"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_glass_card"
                android:clipToPadding="false"
                android:padding="4dp" />
        </LinearLayout>

        <!-- 当前消息显示区域 -->
        <TextView
            android:id="@+id/bubbleMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_glass"
            android:padding="8dp"
            android:textColor="#333"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 照片预览 -->
        <ImageView
            android:id="@+id/bubblePhoto"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_glass_card" />

        <!-- 内容输入 -->
        <EditText
            android:id="@+id/bubbleBody"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input_glass"
            android:hint="输入内容..."
            android:maxLength="200"
            android:paddingHorizontal="10dp"
            android:textSize="13sp" />

        <!-- 发送按钮 -->
        <Button
            android:id="@+id/btnBubbleSend"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_gradient"
            android:text="发送提醒"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
